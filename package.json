{
  "name": "put-study-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PUT Kompendium — platforma do nauki 6 przedmiotow Semestru I (Sieci, Analiza, Probabilistyka, Algebra, AiSD, Fizyka)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "seed": "node server/seed.js",
    "build": "vite build",
    "start": "node server/index.js",
    "start:prod": "NODE_ENV=production HOST=0.0.0.0 node server/index.js",
    "test:api": "node --test tests/api.test.js",
    "build:static": "node scripts/export-static.js && VITE_STATIC=1 VITE_BASE=${VITE_BASE:-/put-kompendium/} vite build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.5"
  }
}
