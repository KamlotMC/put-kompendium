# Środowisko produkcyjne / lokalne PUT Kompendium
NODE_ENV=production
HOST=0.0.0.0
PORT=3456

# Ścieżka do bazy SQLite (w kontenerze Docker: /app/data/study.db)
STUDY_DB_PATH=./data/study.db

# Ustaw "true", gdy aplikacja stoi za Caddy / Nginx / Cloudflare / Render
TRUST_PROXY=true

# Dozwolone domeny CORS (* lub rozdzielone przecinkami, np. https://kompendium.example.com)
CORS_ORIGIN=*
